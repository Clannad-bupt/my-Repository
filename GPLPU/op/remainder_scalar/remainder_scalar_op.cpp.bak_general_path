constexpr uint8_t RTOVR_IN_DR_INTADD_D0 = 0;
constexpr uint8_t RTOVR_IN_DR_LOGIC_D = 10;
constexpr uint8_t RTOVR_IN_UR_RDATA_0 = 30;
constexpr uint8_t RTOVR_IN_UR_RDATA_1 = 31;
constexpr uint8_t RTOVR_IN_UR_RDATA_2 = 32;

constexpr uint8_t RTOVR_OUT_DVR_INTADD_S0 = 0;
constexpr uint8_t RTOVR_OUT_DVR_INTADD_S1 = 1;
constexpr uint8_t RTOVR_OUT_DVR_LOGIC_S0 = 11;
constexpr uint8_t RTOVR_OUT_DVR_LOGIC_S1 = 12;
constexpr uint8_t RTOVR_OUT_UVR_WDATA_0 = 35;

constexpr uint32_t kBitsEmbed = 3;
constexpr uint32_t kBitsEmbedEnd = 6;
constexpr uint32_t kBitsLoops = 10;
constexpr uint32_t kBitsCond = 7;
constexpr uint32_t kBitsDly = 3;
constexpr uint32_t kBitsInc = 4;
constexpr uint32_t kBitsIncEmbed = 6;
constexpr uint32_t kMaskEmbed = (1u << kBitsEmbed) - 1;
constexpr uint32_t kMaskEmbedEnd = (1u << kBitsEmbedEnd) - 1;
constexpr uint32_t kMaskLoops = (1u << kBitsLoops) - 1;
constexpr uint32_t kMaskCond = (1u << kBitsCond) - 1;
constexpr uint32_t kMaskDly = (1u << kBitsDly) - 1;
constexpr uint32_t kMaskInc = (1u << kBitsInc) - 1;
constexpr uint32_t kMaskIncEmbed = (1u << kBitsIncEmbed) - 1;

RemainderScalarDataType to_dtype(app::AppDataType dtype) {
    if (dtype != app::AppDataType::INT32) {
        throw std::runtime_error("RemainderScalar only supports INT32 input/output");
    }
    return RemainderScalarDataType::INT32;
}

int32_t get_i32_param(const app::AppOperatorRequest& req, const std::string& key, int32_t def) {
    auto it = req.para_parameters.find(key);
    if (it != req.para_parameters.end() && !it->second.para_data_i32.empty()) {
        return it->second.para_data_i32[0];
    }
    return def;
}

int32_t get_scalar(const app::AppOperatorRequest& req) {
    for (const char* key : {"other_scalar", "scalar", "scalar_value"}) {
        auto pit = req.para_parameters.find(key);
        if (pit != req.para_parameters.end() && !pit->second.para_data_i32.empty()) {
            return pit->second.para_data_i32[0];
        }
        auto iit = req.para_inputs.find(key);
        if (iit != req.para_inputs.end() && !iit->second.para_data_i32.empty()) {
            return iit->second.para_data_i32[0];
        }
    }
    auto it = req.para_inputs.find("other_tensor");
    if (it != req.para_inputs.end() && !it->second.para_data_i32.empty()) return it->second.para_data_i32[0];
    return 16;
}

bool is_positive_power_of_two(int32_t v) {
    return v > 0 && (v & (v - 1)) == 0;
}

void push_u32(std::vector<uint8_t>& out, uint32_t v) {
    out.push_back(static_cast<uint8_t>(v & 0xFF));
    out.push_back(static_cast<uint8_t>((v >> 8) & 0xFF));
    out.push_back(static_cast<uint8_t>((v >> 16) & 0xFF));
    out.push_back(static_cast<uint8_t>((v >> 24) & 0xFF));
}

uint64_t serialize_header_bits(uint8_t vld, uint8_t jump, uint8_t embed, uint16_t loops,
                               uint8_t cond, uint8_t dly, int8_t inc,
                               uint8_t embed_end_bits, uint8_t inc_embed_bits) {
    uint64_t bits = 0;
    uint32_t pos = 0;
    const uint8_t embed_end = (embed == 0) ? (embed_end_bits & kMaskEmbedEnd) : 0u;
    const uint8_t inc_embed = (embed == 0) ? (inc_embed_bits & kMaskIncEmbed) : 0u;
    bits |= static_cast<uint64_t>(inc_embed & kMaskIncEmbed) << pos; pos += kBitsIncEmbed;
    bits |= static_cast<uint64_t>(static_cast<uint8_t>(inc) & kMaskInc) << pos; pos += kBitsInc;
    bits |= static_cast<uint64_t>(dly & kMaskDly) << pos; pos += kBitsDly;
    bits |= static_cast<uint64_t>(cond & kMaskCond) << pos; pos += kBitsCond;
    bits |= static_cast<uint64_t>(loops & kMaskLoops) << pos; pos += kBitsLoops;
    bits |= static_cast<uint64_t>(embed_end & kMaskEmbedEnd) << pos; pos += kBitsEmbedEnd;
    bits |= static_cast<uint64_t>(embed & kMaskEmbed) << pos; pos += kBitsEmbed;
    bits |= static_cast<uint64_t>(jump & 1u) << pos; pos += 1;
    bits |= static_cast<uint64_t>(vld & 1u) << pos;
    return bits;
}

std::vector<uint8_t> serialize_code(uint64_t code, uint16_t code_bits) {
    std::vector<uint8_t> bytes;
    const uint16_t num_bytes = (code_bits + 7) / 8;
    for (int i = num_bytes - 1; i >= 0; --i) {
        bytes.push_back(static_cast<uint8_t>((code >> (i * 8)) & 0xFF));
    }
    return bytes;
}

std::vector<uint8_t> make_inst(uint8_t vld, uint8_t jump, uint8_t embed, uint16_t loops,
                               uint8_t cond, uint8_t dly, int8_t inc,
                               uint8_t embed_end_bits, uint8_t inc_embed_bits,
                               const std::vector<uint8_t>& code_bytes,
                               int code_bits) {
    const uint64_t h = serialize_header_bits(vld, jump, embed, loops, cond, dly, inc,
                                             embed_end_bits, inc_embed_bits);
    uint64_t c = 0;
    for (uint8_t b : code_bytes) c = (c << 8) | b;
    if (code_bits < 64) c &= ((1ULL << code_bits) - 1ULL);
    const uint64_t total = (h << code_bits) | c;
    const int total_width = 41 + code_bits;
    const int num_bytes = (total_width + 7) / 8;
    std::vector<uint8_t> ret;
    for (int i = num_bytes - 1; i >= 0; --i) {
        ret.push_back(static_cast<uint8_t>((total >> (i * 8)) & 0xFF));
    }
    return ret;
}

std::vector<uint8_t> make_ur_w_inst(uint8_t vld, uint8_t jump, uint8_t embed, uint16_t loops,
                                    uint8_t cond, uint8_t dly, uint8_t inc,
                                    uint8_t embed_end_bits, uint8_t inc_embed_bits,
                                    uint64_t code, uint16_t code_bits) {
    const uint64_t header = serialize_header_bits(vld, jump, embed, loops, cond, dly, inc,
                                                  embed_end_bits, inc_embed_bits);
    const uint64_t mask = (code_bits >= 64) ? ~0ULL : ((1ULL << code_bits) - 1ULL);
    const unsigned __int128 inst =
        (static_cast<unsigned __int128>(header) << code_bits) |
        static_cast<unsigned __int128>(code & mask);
    std::vector<uint8_t> bytes;
    const int total_width = 41 + code_bits;
    const int num_bytes = (total_width + 7) / 8;
    for (int i = num_bytes - 1; i >= 0; --i) {
        bytes.push_back(static_cast<uint8_t>((inst >> (i * 8)) & 0xFF));
    }
    return bytes;
}

void gen_ur_read(const RemainderScalarParams& p, iq::UrCru& cru) {
    cru.para_vld = true;
    cru.para_raddr[0].bank = p.para_input_bank;
    cru.para_raddr[0].addr_word = p.para_input_addr;
    cru.para_re[0] = true;
    cru.para_raddr[1].bank = p.para_scalar_bank;
    cru.para_raddr[1].addr_word = p.para_scalar_addr;
    cru.para_re[1] = true;
    cru.para_raddr[2].bank = p.para_one_bank;
    cru.para_raddr[2].addr_word = p.para_one_addr;
    cru.para_re[2] = true;
    cru.para_re[3] = false;
    for (int i = 0; i < 4; ++i) cru.para_we[i] = false;
}

void gen_ur_write(const RemainderScalarParams& p, iq::UrCru& cru) {
    cru.para_vld = true;
    for (int i = 0; i < 4; ++i) cru.para_re[i] = false;
    cru.para_waddr[0].bank = p.para_output_bank;
    cru.para_waddr[0].addr_word = p.para_output_addr;
    cru.para_we[0] = true;
    cru.para_wbe[0] = 0xFFFF;
    cru.para_we[1] = cru.para_we[2] = cru.para_we[3] = false;
}

