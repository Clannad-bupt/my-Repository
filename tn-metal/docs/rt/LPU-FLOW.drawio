        <mxCell id="rt2" value="选后端: LPU_RT_BACKEND / flags /&#xa;/dev/lpu0 存在 → sim | device" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
