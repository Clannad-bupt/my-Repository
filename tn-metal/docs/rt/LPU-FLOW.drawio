  <diagram id="p2" name="2-ap-sched-fw">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ap1" value="上电: 全核 gp/sp/mtvec(栈阵 4×16K)&#xa;core0 独家清 .bss → main(0); core1..3 → 唤醒轮询" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ap2" value="main: uart init + sched_ep_init&#xa;(寄存器块 / host 窗口基址)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="140" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ap3" value="sched_ring_poll(): 16 流轮询&#xa;+ host 清事件消费 [sched_ring.c:98]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ap4" value="门铃?&#xa;(Q_WP[s] &gt; rp[s])" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="320" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap5" value="ring_fetch: EP outbound 窗口&#xa;(0x92000000) 拉 32B 描述符" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ap6" value="KERNEL 描述符?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="540" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap6a" value="EVENT: signal / clear 事件位&#xa;BARRIER: mask 就绪? 否 → 停在流头保序&#xa;COPY / CPU_OP: v1 未实现 → CQ ERR&#xa;→ 继续轮询后续描述符" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="530" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ap7" value="sched_dispatch_kernel [sched_dispatch.c:108]:&#xa;拉 task → cluster → 先校验全部&#xa;block 的 gang N(出错路径不留忙核)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap8" value="EVAL 就绪?&#xa;(wait_mask 事件全部到齐)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="780" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap8a" value="有限自旋(2×10^7) 超时&#xa;→ CQ ERR status=5(防 host 依赖永不满足)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="780" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ap9" value="逐 block × role 派发:&#xa;core_acquire(忙掩码; 全忙 → 先收割)&#xa;core_dispatch: 填 mailbox(0x78000000+cid×64)&#xa;→ fence rw,rw → start=1(交棒 scalar, 见 page 3)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="900" width="320" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ap10" value="core_reap: 查忙核 done==1 → 记 kern_status&#xa;→ 清 start/done → 释放核 → cluster_left--&#xa;(清 start 把 scalar 核放出等待循环)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="1040" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ap11" value="cluster 全收割?&#xa;(cluster_left==0)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="1170" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap12" value="信号级联: cluster signal_mask&#xa;→ task_signal_mask" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="1290" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ap13" value="sched_cq_write(KERNEL_DONE, kern_status):&#xa;EP 窗口 posted write 16B → host CQ&#xa;→ CQ_WP++(满 / 未配置 → 丢弃不推进)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="1390" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ap14" value="rp_publish: RP 影子 + Q_CTX.RP 回写&#xa;(host 判流排空全靠影子) → 回轮询" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="300" y="1510" width="320" height="60" as="geometry" />
